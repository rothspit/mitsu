NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder_key
NEXT_PUBLIC_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/★ここにWebhook URLを貼り付け

# WEB予約Discord通知用（未設定時は既存Webhookへ送信）
RESERVE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# 店舗別チャンネルに分ける場合のみ設定
RESERVE_DISCORD_WEBHOOK_NISHIFUNA=
RESERVE_DISCORD_WEBHOOK_KASAI=
RESERVE_DISCORD_WEBHOOK_KINSHICHO=

# CRM 即姫 → 公式同期（POST /api/sync-schedule, Header: x-sync-secret）
MITSU_SYNC_SECRET=
NEXT_PUBLIC_CRM_API_URL=https://crm.h-mitsu.com
# 会員ログイン・Web予約（公式CTAの遷移先）
NEXT_PUBLIC_MEMBERSHIP_URL=https://crm.st-online.jp/membership
# WEB予約のCRM転送先（未設定時は NEXT_PUBLIC_CRM_API_URL + /api/reserve）
CRM_RESERVE_URL=https://crm.h-mitsu.com/api/reserve
CRM_RESERVE_SECRET=
# 店舗ページでは CRM stores.code から store_id を解決。単体デバッグ用のみ:
# HONSHIMEI_RANKING_STORE_ID=1
HONSHIMEI_RANKING_REVALIDATE_SECONDS=3600
